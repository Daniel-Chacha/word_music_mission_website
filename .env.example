# ---------------------------------------------------------------------------
# All of this is optional. With none of it set the site runs fine: the shop
# renders and every product falls back to "Order on WhatsApp".
# Copy to .env.local and fill in to switch on online checkout.
# ---------------------------------------------------------------------------

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Firebase Admin — Project settings > Service accounts > Generate new private key
# FIREBASE_PRIVATE_KEY must keep its \n escapes and stay wrapped in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Admin order list at /admin/orders
# Generate the cookie secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=

# Public site URL, used for Paystack callbacks and sitemap entries
NEXT_PUBLIC_SITE_URL=http://localhost:3000
