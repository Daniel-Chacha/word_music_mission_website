# ---------------------------------------------------------------------------
# Copy to .env.local (and to your host's environment variables) and fill in.
# Without GMAIL_USER and GMAIL_APP_PASSWORD the site still runs, but shop
# orders and contact forms show an "email us instead" message.
# ---------------------------------------------------------------------------

# Gmail account the site sends from. Needs 2-Step Verification on, then create
# an app password at https://myaccount.google.com/apppasswords (16 characters).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Inbox that receives orders and contact messages.
# Optional: defaults to the contact email in content/site.ts.
MAIL_TO="wordmusc@gmail.com"